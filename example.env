# nn-friends: Wii U / 3DS friends server (NEX authentication + secure) over the OpenPak core.
# Copy to .env and fill in. Never commit .env.

# Adapter's own PostgreSQL database (presence, notifications, Mii cache). Never the core's.
PN_FRIENDS_CONFIG_POSTGRES_URI=postgres://nn_friends:secret@localhost:5432/nn_friends?sslmode=disable
PN_FRIENDS_CONFIG_POSTGRES_MAX_CONNECTIONS=20

# NEX listeners. The secure host is the public name consoles are redirected to.
PN_FRIENDS_CONFIG_AUTHENTICATION_SERVER_PORT=60000
PN_FRIENDS_CONFIG_SECURE_SERVER_HOST=friends.openpak.example
PN_FRIENDS_CONFIG_SECURE_SERVER_PORT=60001
PN_FRIENDS_CONFIG_HEALTH_CHECK_PORT=

# This server's own gRPC (presence for game servers) and the key callers must present.
PN_FRIENDS_CONFIG_GRPC_SERVER_PORT=60002
PN_FRIENDS_CONFIG_GRPC_API_KEY=change-me-friends-grpc-key

# nn-account (the Wii U/3DS adapter) gRPC: NN_ACCOUNT_GRPC_ADDR and NN_ACCOUNT_GRPC_API_KEY there.
PN_FRIENDS_CONFIG_ACCOUNT_GRPC_HOST=localhost
PN_FRIENDS_CONFIG_ACCOUNT_GRPC_PORT=7001
PN_FRIENDS_CONFIG_ACCOUNT_GRPC_API_KEY=change-me-adapter-grpc-key-change-me!

# OpenPak account core internal gRPC: the friend graph lives there (coregraph).
PN_FRIENDS_CONFIG_OPEN_PAK_CORE_HOST=localhost
PN_FRIENDS_CONFIG_OPEN_PAK_CORE_PORT=7000
PN_FRIENDS_CONFIG_OPEN_PAK_CORE_KEY=change-me-core-internal-key-change-me-internal!

# Console-side keys. Hex AES key for 3DS Mii data; HMAC key for the pidHMAC field.
PN_FRIENDS_CONFIG_MII_DECRYPT_KEY=
PN_FRIENDS_CONFIG_PID_HMAC_KEY=change-me

# Debug: a user named "Bella" who is always your friend.
PN_FRIENDS_CONFIG_ENABLE_BELLA=false
